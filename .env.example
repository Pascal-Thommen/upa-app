# ==========================================
# UPA App Stack Environment Configuration
# ==========================================

# Application Environment (development, test, production)
APP_ENV=production

# Backend Service
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL 16 Configuration
POSTGRES_DB=upa_db
POSTGRES_USER=upa_user
POSTGRES_PASSWORD=upa_secure_pass_2026
POSTGRES_PORT=5432

# Database Connection (Backend to Postgres Container)
DATABASE_URL=postgresql://upa_user:upa_secure_pass_2026@postgres:5432/upa_db

# Web Admin Portal (Optional / Modular)
WEB_ADMIN_PORT=3000

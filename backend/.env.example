# ==========================================
# UPA App Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO GIT!
# Copy this file to .env and configure locally.
# ==========================================

# Server Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Authentication (Google OAuth 2.0)
# Restricted to domain: upa.edu.py
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_EMAIL_DOMAIN=upa.edu.py

# Google Workspace Admin SDK (Service Account for Groups sync)
# Path to local JSON file (must be added to .gitignore)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_ADMIN_DELEGATED_USER=admin@upa.edu.py

# Google Classroom API
GOOGLE_CLASSROOM_ENABLED=false

# Social Media Integration (SociableKIT or Instagram API)
SOCIABLEKIT_EMBED_ID=your-sociablekit-embed-id
INSTAGRAM_ACCESS_TOKEN=your-optional-instagram-token

# Database
DATABASE_URL=sqlite:///./upa_app.db

# Media Upload (POST /api/media/upload, served under /uploads)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
# PUBLIC_BASE_URL=https://api.upa.edu.py

# Push notifications (Firebase Cloud Messaging HTTP v1, service account JSON stays out of git)
FCM_SERVICE_ACCOUNT_FILE=./secrets/fcm-service-account.json
# FCM_PROJECT_ID=your-firebase-project-id
FCM_TIMEOUT_SECONDS=10

# Control de IA (Google Gemini). Se puede guardar desde el reiter "Control de IA" del web-admin.
AI_EVENT_EXTRACTION_ENABLED=true
# GEMINI_API_KEY=tu-clave-de-google-ai-studio
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_IMAGE_BYTES=4194304

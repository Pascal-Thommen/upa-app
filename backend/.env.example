# ==========================================
# UPA App Backend Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO GIT!
# Copy this file to backend/.env and configure locally.
# Synchronized with backend/src/config.py
# ==========================================

# Server Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8085,https://upa.eu1.netbird.services,https://upa-beta.eu1.netbird.services

# Authentication (Google OAuth 2.0, restricted to @upa.edu.py)
ALLOWED_EMAIL_DOMAIN=upa.edu.py
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=
ALLOWED_GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com

# Google Workspace Admin Directory API (Service Account for Groups sync)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_ADMIN_DELEGATED_USER=soporte.ti@upa.edu.py

# JWT Session Configuration
JWT_SECRET=change-this-to-a-unique-production-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL 16 Database
DATABASE_URL=postgresql://upa_user:upa_password@postgres:5432/upa_app

# Social Media & Instagram Sync (@upalemana)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
SOCIABLEKIT_EMBED_ID=25723525
FEED_SYNC_INTERVAL_MINUTES=60
FEED_SYNC_ENABLED=true

# Media Upload (POST /api/media/upload, served under /uploads)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
PUBLIC_BASE_URL=

# Push Notifications (Firebase Cloud Messaging HTTP v1)
FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
FCM_PROJECT_ID=upa-campus-app
FCM_TIMEOUT_SECONDS=10.0
FCM_API_BASE_URL=https://fcm.googleapis.com

# Control de IA (Google Gemini Flash)
AI_EVENT_EXTRACTION_ENABLED=true
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=45.0
GEMINI_MAX_IMAGE_BYTES=4194304
